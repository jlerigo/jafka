{
    "name": "Apache Kafka Development",
    "build": {
        "context": "..",
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "redhat.java",
                "vscjava.vscode-gradle"
            ],
            "settings": {
                "java.configuration.updateBuildConfiguration": "automatic",
                "editor.formatOnSave": true,
                "java.jdt.ls.java.home": "/usr/lib/jvm/msopenjdk-current",
                "gradle.java.home": "/usr/lib/jvm/msopenjdk-current"
            }
        }
    },
    "containerEnv": {
        "JAVA_HOME": "/usr/lib/jvm/msopenjdk-current",
        "PATH": "/usr/lib/jvm/msopenjdk-current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/vscode/.local/bin"
    },
    "forwardPorts": [9092, 2181, 8080],
    "remoteUser": "vscode",
    "postCreateCommand": "chmod +x gradlew"
}
